{
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "breadcrumbs.enabled": false,
    "editor.minimap.enabled": false,
    "window.zoomLevel": 1,
    "workbench.tree.indent": 12,
    "editor.fontFamily": "'JetBrains Mono', monospace",
    "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
    // ========================
    // 2. EDITOR BEHAVIOR & PERFORMANCE
    // ========================
    "editor.fontSize": 13,
    "terminal.integrated.fontSize": 13,
    "editor.lineNumbers": "relative",
    "editor.cursorBlinking": "solid",
    "editor.renderWhitespace": "none",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.mouseWheelZoom": true,
    "editor.formatOnSave": true,
    "editor.parameterHints.enabled": false,
    "editor.workbench.editor.enablePreview": false,
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": false
    },
    // ========================
    // 3. VIM CORE CONFIG (Leader = Space)
    // ========================
    "vim.useCtrlKeys": true,
    "vim.leader": "<space>",
    "vim.hlsearch": true,
    "vim.handleKeys": {
        " <C-b>": false,
        " <C-p>": false,
        " <C-f>": false,
        " <C-v>": false
    },
    // ========================
    // 4. VIM KEYBINDINGS (Sway / Tiling Style)
    // ========================
    "vim.normalModeKeyBindingsNonRecursive": [
        // Window Management (Splits)
        {
            "before": [
                "<leader>",
                "v"
            ],
            "commands": [
                "workbench.action.splitEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "s"
            ],
            "commands": [
                "workbench.action.splitEditorDown"
            ]
        },
        // Focus Movement (h, j, k, l)
        {
            "before": [
                "<leader>",
                "h"
            ],
            "commands": [
                "workbench.action.focusLeftGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "l"
            ],
            "commands": [
                "workbench.action.focusRightGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "j"
            ],
            "commands": [
                "workbench.action.focusBelowGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "k"
            ],
            "commands": [
                "workbench.action.focusAboveGroup"
            ]
        },
        // Tab Navigation
        {
            "before": [
                "L"
            ],
            "commands": [
                "workbench.action.nextEditorInGroup"
            ]
        },
        {
            "before": [
                "H"
            ],
            "commands": [
                "workbench.action.previousEditorInGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "<tab>"
            ],
            "commands": [
                "workbench.action.openPreviousEditor"
            ]
        },
        // Tab Numbers
        {
            "before": [
                "<leader>",
                "1"
            ],
            "commands": [
                "workbench.action.openEditorAtIndex1"
            ]
        },
        {
            "before": [
                "<leader>",
                "2"
            ],
            "commands": [
                "workbench.action.openEditorAtIndex2"
            ]
        },
        {
            "before": [
                "<leader>",
                "3"
            ],
            "commands": [
                "workbench.action.openEditorAtIndex3"
            ]
        },
        {
            "before": [
                "<leader>",
                "4"
            ],
            "commands": [
                "workbench.action.openEditorAtIndex4"
            ]
        },
        {
            "before": [
                "<leader>",
                "5"
            ],
            "commands": [
                "workbench.action.openEditorAtIndex5"
            ]
        },
        // UI Toggles
        {
            "before": [
                "<leader>",
                "b"
            ],
            "commands": [
                "workbench.action.toggleSidebarVisibility"
            ]
        },
        {
            "before": [
                "<leader>",
                "i"
            ],
            "commands": [
                "workbench.action.toggleAuxiliaryBar"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.view.explorer"
            ]
        },
        {
            "before": [
                "<leader>",
                "t"
            ],
            "commands": [
                "workbench.action.terminal.toggleTerminal"
            ]
        },
        // General Utilities
        {
            "before": [
                "<leader>",
                "w"
            ],
            "commands": [
                "workbench.action.files.save"
            ]
        },
        {
            "before": [
                "<leader>",
                "q"
            ],
            "commands": [
                "workbench.action.closeActiveEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "workbench.action.showCommands"
            ]
        },
        {
            "before": [
                "<leader>",
                "r"
            ],
            "commands": [
                "dotnet.build"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "commands": [
                "workbench.actions.view.problems"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                ":nohlsearch"
            ]
        }
    ],
    // ========================
    // 5. FILES & PRIVACY
    // ========================
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/.git": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "**/bin": true,
        "**/obj": true
    },
    "explorer.confirmDelete": false,
    "telemetry.telemetryLevel": "off",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    // ========================
    // 6. LANGUAGES & IA
    // ========================
    "python.defaultInterpreterPath": "C:\\Program Files\\Python313\\python.exe",
    "github.copilot.enable": {
        "*": true,
        "markdown": true,
        "plaintext": true
    },
    "github.copilot.inlineSuggest.enable": true,
    "gitlens.ai.model": "vscode",
    "git.autofetch": true,
    "security.workspace.trust.untrustedFiles": "open",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "workbench.browser.enableChatTools": true,
    "chat.mcp.gallery.enabled": true,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://github.com": true
    },
    "chat.tools.terminal.autoApprove": {
        "mkdir": true,
        "mv": true,
        "true": true,
        "dart": true,
        "flutter": true,
        "cp": true,
        "read": true,
        "npx create-next-app@latest": true,
        "npm install": true,
        "printf": true,
        "npm run build": true,
        "npm run lint": true,
        "npx prisma": true,
        "npx eslint": true,
        "npx tsc": true,
        "npm --prefix /home/gustavo/projects/portal-perito/apps/web": true,
        "/^node -e \"fetch\\('http://localhost:3001/peritos'\\)\\.then\\(r=>r\\.json\\(\\)\\)\\.then\\(d=>console\\.log\\(d\\[0\\]\\?\\.public_id \\|\\| ''\\)\\)\"$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "npm run typecheck": true,
        "npm run dev": true
    },
    "explorer.confirmDragAndDrop": false,
    "git.confirmSync": false
}