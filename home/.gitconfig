[user]
	email = gfsousa42@gmail.com
	name = gustavofsousa
[init]
    defaultBranch = main

[core]
    editor = nvim

[help]
    autocorrect = 1

[color]
    ui = auto

[rerere]
    enabled = true

[credential]
    helper = cache --timeout=3600

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[diff]
    colorMoved = default

